# ── Django asosiy ──
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=uyimiz-backend.fly.dev,api.uyimiz.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://uyimiz-backend.fly.dev,https://api.uyimiz.uz
