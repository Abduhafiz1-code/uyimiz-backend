# ── Django asosiy ──
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=uyimiz-backend.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://uyimiz-backend.onrender.com
DJANGO_LOG_LEVEL=INFO

# ── SMS / OTP ──
# 1 = SMS provayder kerak emas, kod API javobida qaytadi (SINOV UCHUN)
# 0 = kod faqat server logida (real SMS kutiladi)
# OMMAGA OCHISHDAN OLDIN ALBATTA 0 QILING
OTP_TEST_MODE=1
SMS_ENABLED=0

# ── Admin hisobi ──
# Konteyner ishga tushganda superadmin yaratiladi/yangilanadi.
# Render Free tarifida Shell yo'q — hisobni faqat shu yo'l bilan yaratasiz.
ADMIN_PHONE=+998901234567
ADMIN_PASSWORD=kamida-8-belgi-uzun-parol

# Demo ma'lumot (tumanlar, e'lonlar, test hisoblari).
# Faqat sinov uchun 1 qiling, keyin olib tashlang.
SEED_DEMO=0

# ── Baza ──
# Render Postgres: Internal Database URL (SSL shart emas)
DATABASE_URL=postgresql://user:parol@dpg-xxxx-a/uyimiz_db
DJANGO_DB_SSL=0
# Tashqi baza (Supabase/Neon) bo'lsa: DJANGO_DB_SSL=1

# ── Media: S3-mos object storage (R2 / Tigris / B2) ──
AWS_STORAGE_BUCKET_NAME=uyimiz-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
# AWS_S3_CUSTOM_DOMAIN=media.uyimiz.uz

# ── CORS (brauzerdagi frontend uchun) ──
CORS_ALLOW_ALL=1
# CORS_ALLOW_ALL=0
# CORS_ALLOWED_ORIGINS=https://uyimiz.uz,https://admin.uyimiz.uz

# ── Render avtomatik beradi (qo'lda yozmang) ──
# PORT
# RENDER_EXTERNAL_HOSTNAME
